<script define:vars={{ email: site.email }}>
  const phoneScreen = document.querySelector('.phone-screen');
  const contactSheet = document.querySelector('[data-contact-sheet]');
  const contactBackdrop = document.querySelector('[data-contact-backdrop]');
  const openContact = document.querySelector('[data-open-contact]');
  const closeContact = document.querySelector('[data-close-contact]');
  const contactForm = document.querySelector('[data-contact-form]');

  const setContactOpen = (isOpen) => {
    contactSheet?.classList.toggle('is-open', isOpen);
    phoneScreen?.classList.toggle('sheet-open', isOpen);
    if (contactBackdrop) contactBackdrop.hidden = !isOpen;
    contactSheet?.setAttribute('aria-hidden', String(!isOpen));
    if (isOpen) contactSheet?.querySelector('input')?.focus();
  };

  openContact?.addEventListener('click', () => setContactOpen(true));
  closeContact?.addEventListener('click', () => setContactOpen(false));
  contactBackdrop?.addEventListener('click', () => setContactOpen(false));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setContactOpen(false); });
  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = new FormData(contactForm);
    const name = String(form.get('name') || '');
    const project = String(form.get('project') || '');
    const subject = encodeURIComponent(`Project enquiry from ${name}`);
    const body = encodeURIComponent(`Hi John, I would like to discuss ${project}.`);
    window.location.href = `mailto:${site.email}?subject=${subject}&body=${body}`;
  });
</script>
