---
import { site, nav } from "../data/site";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.summary } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | {site.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="wrap nav">
        <a class="brand" href="/">{site.name}</a>
        <div class="navr">
          <nav aria-label="Main">
            <ul class="links">
              {
                nav.map((n) => (
                  <li>
                    <a
                      href={n.href}
                      class={n.cta ? "pill" : undefined}
                      aria-current={path === n.href ? "page" : undefined}
                    >
                      {n.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <button class="theme" type="button" aria-label="Switch between light and dark theme">
            <span class="sun"><Icon name="sun" size={20} /></span>
            <span class="moon"><Icon name="moon" size={20} /></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="wrap footer">
      <span>© {year} {site.fullName}</span>
      <span class="foot-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github}>GitHub</a>
      </span>
    </footer>

    <script>
      const btn = document.querySelector(".theme");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ground: #f2f5f9; --surface: #ffffff; --ink: #12202f; --muted: #4a5a6b;
    --line: #c9d3de; --accent: #4f46e5; --accent-text: #4338ca;
    --panel: #12202f; --asphalt: #2b3b4d; --code: #0f1a2b;
    --mono: "JetBrains Mono", ui-monospace, monospace;
  }
  :root[data-theme="dark"] {
    --ground: #0a101c; --surface: #111b2d; --ink: #e8eef6; --muted: #a3b1c4;
    --line: #24324a; --accent: #4f46e5; --accent-text: #a9a4ff;
    --panel: #16233a; --asphalt: #22314a; --code: #070c16;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #0a101c; --surface: #111b2d; --ink: #e8eef6; --muted: #a3b1c4;
      --line: #24324a; --accent: #4f46e5; --accent-text: #a9a4ff;
      --panel: #16233a; --asphalt: #22314a; --code: #070c16;
    }
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--ground); color: var(--ink);
    font-family: "Figtree", system-ui, sans-serif; font-size: 18px; line-height: 1.6;
  }
  h1, h2, h3 {
    font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
    margin: 0; letter-spacing: -0.02em; line-height: 1.1;
  }
  p, ul { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 3px; }
  .wrap { max-width: 1100px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; background: var(--surface); padding: 8px 12px; z-index: 20; }

  /* Header */
  .bar {
    position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(10px);
  }
  .nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding-top: 14px; padding-bottom: 14px; }
  .brand { font-family: "Bricolage Grotesque", sans-serif; font-weight: 800; font-size: 22px; }
  .navr { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 22px; font-weight: 500; font-size: 16px; }
  .links a { display: inline-block; padding: 6px 0; }
  .links a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--accent-text); }
  .links .pill { background: var(--ink); color: var(--ground); padding: 8px 18px; border-radius: 999px; }
  .links .pill[aria-current="page"] { background: var(--accent); color: #fff; box-shadow: none; }
  .theme { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .theme:hover { border-color: var(--accent-text); }
  .theme span { display: none; line-height: 0; }
  .theme .moon { display: block; }
  :root[data-theme="dark"] .theme .sun { display: block; }
  :root[data-theme="dark"] .theme .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme .sun { display: block; }
    :root:not([data-theme="light"]) .theme .moon { display: none; }
  }

  /* Heads and sections */
  .page-head { padding-top: 64px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 20px; }
  .page-head h1 { font-size: clamp(40px, 6.5vw, 76px); font-weight: 800; max-width: 18ch; }
  .lead { color: var(--muted); font-size: 20px; max-width: 56ch; }
  .section { padding-top: 64px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 32px; }
  .section h2 { font-size: clamp(30px, 4.5vw, 48px); font-weight: 800; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }
  .more { font-weight: 700; color: var(--accent-text); }
  .more:hover { text-decoration: underline; }
  .prose { display: flex; flex-direction: column; gap: 18px; max-width: 62ch; }

  /* Home hero */
  .hero-wrap { position: relative; }
  .hero-wrap::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(var(--line) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 70% 80% at 70% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 70% 40%, #000 20%, transparent 75%);
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding-top: 56px; padding-bottom: 32px; }
  .hero-grid h1 { font-size: clamp(40px, 5.6vw, 72px); font-weight: 800; }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .eyebrow {
    margin: 0; font: 500 14px/1.5 var(--mono); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-text);
  }
  .stats-row {
    position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding-bottom: 24px;
  }
  .stat {
    display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border: 1px solid var(--line); background: rgba(255,255,255,0.3);
    border-radius: 18px; backdrop-filter: blur(4px);
  }
  .stat strong { font-size: clamp(20px, 2vw, 30px); font-family: "Bricolage Grotesque", sans-serif; }
  .stat span { color: var(--muted); font-size: 15px; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .stats-row { grid-template-columns: 1fr; } }

  /* Buttons and chips */
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn { display: inline-block; font-weight: 700; padding: 16px 28px; border-radius: 999px; border: 2px solid transparent; }
  .primary { background: var(--accent); color: #fff; }
  .primary:hover { background: #4338ca; }
  .outline { border-color: var(--ink); }
  .outline:hover { background: var(--ink); color: var(--ground); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { font: 500 14px var(--mono); padding: 6px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }

  /* Service tiles */
  .bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .tile {
    grid-column: span 2; background: var(--surface); border: 1px solid var(--line);
    border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 14px;
    transition: border-color 0.2s, transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none; color: inherit;
  }
  a.tile:hover, .tile:hover { border-color: var(--accent-text); transform: translateY(-2px); box-shadow: 0 14px 30px rgba(79, 70, 229, 0.08); }
  .bento:not(.three) .tile:nth-child(1) { grid-column: span 4; }
  .bento:not(.three) .tile:nth-child(6), .bento:not(.three) .tile:nth-child(7) { grid-column: span 3; }
  .bento:not(.three) .tile:nth-child(1) { background: var(--accent); border-color: transparent; color: #fff; }
  .bento:not(.three) .tile:nth-child(1) p, .bento:not(.three) .tile:nth-child(1) li { color: #e6e4ff; }
  .bento:not(.three) .tile:nth-child(1) .ico { background: rgba(255, 255, 255, 0.18); color: #fff; }
  .tile h3 { font-size: 24px; font-weight: 600; }
  .tile p, .tile li { color: var(--muted); }
  .tile ul { list-style: disc; padding-left: 20px; display: flex; flex-direction: column; gap: 4px; }
  .ico { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent-text); }
  @media (max-width: 800px) { .bento { grid-template-columns: 1fr; } .bento .tile { grid-column: auto !important; } }

  /* Rows */
  .row { display: grid; grid-template-columns: minmax(140px, 260px) 1fr; gap: 12px 40px; padding: 28px 0; border-top: 1px solid var(--line); }
  .row > h3 { font-size: 26px; font-weight: 600; }
  .row .body { display: flex; flex-direction: column; gap: 12px; max-width: 62ch; }
  .row .body h3 { font-size: 26px; font-weight: 600; }
  .row .body p, .row .body li { color: var(--muted); }
  .row ul { list-style: disc; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .when { color: var(--accent-text); font: 500 15px var(--mono); padding-top: 6px; }
  .body a { color: var(--accent-text); font-weight: 700; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } }

  /* Project showcase */
  .showcase { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 40px 0; border-top: 1px solid var(--line); }
  .showcase:nth-child(even) .art { order: 2; }
  .showcase .info { display: flex; flex-direction: column; gap: 14px; }
  .showcase h3 { font-size: clamp(26px, 3.4vw, 36px); font-weight: 800; }
  .showcase p { color: var(--muted); }
  .stack { font: 400 14px/1.6 var(--mono); }
  @media (max-width: 800px) { .showcase { grid-template-columns: 1fr; gap: 24px; } .showcase:nth-child(even) .art { order: 0; } }

  /* Steps */
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
  .step { position: relative; border-top: 2px solid var(--line); padding-top: 22px; display: flex; flex-direction: column; gap: 8px; }
  .step::before { content: ""; position: absolute; top: -2px; left: 0; width: 56px; border-top: 2px solid var(--accent-text); }
  .num { font: 500 14px var(--mono); color: var(--accent-text); }
  .step h3 { font-size: 22px; font-weight: 600; }
  .step p { color: var(--muted); font-size: 17px; }

  /* Contact tiles */
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .tile .label { font: 500 14px var(--mono); color: var(--muted); }
  .tile .value { font-weight: 700; font-size: 20px; overflow-wrap: anywhere; }

  /* Code colours */
  .k { color: #c4b5fd; } .s { color: #86efac; } .p { color: #7dd3fc; } .c { color: #8a9bb5; }

  /* Footer */
  .footer { margin-top: 24px; padding-top: 32px; padding-bottom: 40px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 15px; color: var(--muted); }
  .foot-links { display: flex; flex-wrap: wrap; gap: 20px; }
  .foot-links a:hover { color: var(--accent-text); }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
