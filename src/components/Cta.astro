---
import { site } from "../data/site";
const { heading = "Have a project in mind?" } = Astro.props;
---

<section class="wrap cta-wrap" aria-label="Contact">
  <div class="cta">
    <h2>{heading}</h2>
    <p>Tell me what you need and I will reply with how I can help.</p>
    <a class="btn" href={`mailto:${site.email}`}>Email me</a>
  </div>
</section>

<style>
  .cta-wrap { padding-bottom: 48px; }
  .cta {
    background: var(--panel); color: #fff; border: 1px solid var(--line); border-radius: 32px; padding: 64px 40px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 20px;
  }
  .cta h2 { font-size: clamp(30px, 4vw, 46px); font-weight: 800; }
  .cta p { color: #c9d3de; max-width: 48ch; }
  .btn {
    display: inline-block; background: #fff; color: #12202f;
    font-weight: 700; padding: 16px 28px; border-radius: 999px;
  }
  .btn:hover { background: #dce6f2; }
</style>
