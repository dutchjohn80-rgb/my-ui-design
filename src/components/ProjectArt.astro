---
const { kind, label } = Astro.props;
const rows = [0, 1, 2, 3, 4];
const bars = [60, 90, 70, 120, 100, 140, 110];
const pts = bars.map((h, i) => `${52 + i * 36},${196 - h * 0.8}`).join(" ");
---

<figure class="frame">
  <div class="top"><span class="tab">{label}</span></div>
  <svg viewBox="0 0 400 240" role="img" aria-label={`Illustration of the ${label} screen`}>
    {kind === "map" && (
      <g>
        <path class="grid" d="M0 60H400M0 120H400M0 180H400M80 0V240M160 0V240M240 0V240M320 0V240" />
        <path class="route" d="M40 190 C120 190 120 110 200 110 S300 60 360 50" />
        <circle cx="40" cy="190" r="7" class="start" />
        <circle cx="360" cy="50" r="9" class="pin" />
        <rect x="130" y="146" width="128" height="30" rx="15" class="chip" />
        <text x="194" y="166" text-anchor="middle" class="label">Arrives in 4 min</text>
      </g>
    )}
    {kind === "table" && (
      <g>
        <rect x="24" y="20" width="352" height="34" rx="10" class="head" />
        {rows.map((i) => (
          <g>
            <rect x="24" y={68 + i * 30} width="352" height="24" rx="8" class="row" />
            <rect x="38" y={76 + i * 30} width="92" height="8" rx="4" class="bar" />
            <rect x="176" y={76 + i * 30} width="44" height="8" rx="4" class="bar" />
            <rect x="302" y={72 + i * 30} width="58" height="16" rx="8" class={i % 3 === 1 ? "tag warn" : "tag"} />
          </g>
        ))}
      </g>
    )}
    {kind === "lang" && (
      <g>
        <rect x="24" y="20" width="352" height="200" rx="12" class="page" />
        <rect x="40" y="36" width="64" height="10" rx="5" class="bar" />
        <rect x="296" y="30" width="68" height="24" rx="12" class="toggle" />
        <text x="314" y="46" class="label on-accent">EN</text>
        <text x="342" y="46" class="label">SW</text>
        <rect x="40" y="76" width="190" height="16" rx="8" class="bar dark" />
        <rect x="40" y="100" width="140" height="16" rx="8" class="bar dark" />
        <rect x="40" y="130" width="96" height="28" rx="14" class="btnx" />
        <rect x="256" y="72" width="104" height="86" rx="14" class="img" />
        <rect x="40" y="176" width="96" height="30" rx="8" class="row" />
        <rect x="152" y="176" width="96" height="30" rx="8" class="row" />
        <rect x="264" y="176" width="96" height="30" rx="8" class="row" />
      </g>
    )}
    {kind === "dash" && (
      <g>
        {[24, 146, 268].map((x) => (
          <g>
            <rect x={x} y="20" width="108" height="52" rx="10" class="row" />
            <rect x={x + 14} y="34" width="46" height="8" rx="4" class="bar" />
            <rect x={x + 14} y="50" width="72" height="12" rx="6" class="bar dark" />
          </g>
        ))}
        <path class="grid" d="M24 196H376M24 156H376M24 116H376" />
        {bars.map((h, i) => <rect x={38 + i * 36} y={196 - h * 0.8} width="22" height={h * 0.8} rx="5" class="col" />)}
        <polyline points={pts} class="trend" />
      </g>
    )}
  </svg>
</figure>

<style>
  .frame { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
  .top { display: flex; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .tab { font: 500 13px "JetBrains Mono", ui-monospace, monospace; color: var(--muted); }
  svg { display: block; width: 100%; height: auto; }
  .grid { stroke: var(--line); stroke-width: 1; fill: none; }
  .route { stroke: var(--accent); stroke-width: 4; fill: none; stroke-linecap: round; stroke-dasharray: 2 10; animation: flow 1.6s linear infinite; }
  .start { fill: var(--accent); }
  .pin { fill: #f5a524; }
  .chip { fill: var(--panel); }
  .label { font: 700 12px "Figtree", sans-serif; fill: #fff; }
  .toggle { fill: var(--ground); stroke: var(--line); }
  .toggle ~ .label { fill: var(--ink); }
  .toggle ~ .on-accent { fill: var(--accent-text); }
  .head { fill: var(--accent); opacity: 0.9; }
  .row { fill: var(--ground); }
  .bar { fill: var(--line); }
  .bar.dark { fill: var(--ink); opacity: 0.85; }
  .tag { fill: #22c55e; opacity: 0.55; }
  .tag.warn { fill: #f5a524; opacity: 0.8; }
  .page { fill: var(--surface); stroke: var(--line); }
  .btnx { fill: var(--accent); }
  .img { fill: var(--accent); opacity: 0.2; }
  .col { fill: var(--accent); opacity: 0.8; }
  .trend { fill: none; stroke: #f5a524; stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  @keyframes flow { to { stroke-dashoffset: -24; } }
  @media (prefers-reduced-motion: reduce) { .route { animation: none; } }
</style>
